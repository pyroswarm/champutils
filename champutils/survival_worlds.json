{
  "enabled": true,
  "overworldCount": 6,
  "netherWorldCount": 2,
  "endWorldCount": 2,
  "overworldPrefix": "multiworld:survival_overworld",
  "netherPrefix": "multiworld:survival_nether",
  "endPrefix": "multiworld:survival_end",
  "borderRadius": 10000,
  "spawnY": 100,
  "runWorldCommands": true,
  "defaultMaxHomes": 3,
  "overworldCreateCommands": [
    "mw create {world_id} NORMAL -g\u003dNORMAL",
